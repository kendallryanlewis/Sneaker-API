# Copy this file to .env and fill in values

PORT=8080
NODE_ENV=development

# StockX Algolia search key (public browser key — rotates periodically)
# To refresh: open stockx.com in Chrome → DevTools → Network → search anything
# Find a POST to xw7sbct9v6-dsn.algolia.net → copy x-algolia-api-key from the URL
STOCKX_ALGOLIA_KEY=

# eBay App ID — free at https://developer.ebay.com/ (register → create app → copy "App ID")
# Enables real sold-price data from eBay completed listings (fills StockX market-data gap)
# Free tier: 5,000 calls/day
EBAY_APP_ID=

